generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Motorista{
  id Int @id @default(autoincrement())
  email String
  nome String
  telefones String
  pedidos Pedido[]
}

model Pedido{
  id Int @id @default(autoincrement())
  MotoristaId Int
  data DateTime @default(now())
  produto String
  valor Decimal @db.Decimal(10,2)
  endereco String
  numero String?
  cep String
  complemento String?
  motorista Motorista @relation(fields: [MotoristaId], references: [id])
}
